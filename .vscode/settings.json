{
    "editor.rulers": [
        88,
        120
    ],
    "editor.renderWhitespace": "all",
    "[python]": {
        "editor.tabSize": 4,
        "editor.detectIndentation": false,
        "editor.insertSpaces": true,
        "editor.formatOnSave": false,
        "editor.codeActionsOnSave": {
            "source.fixAll": "explicit",
            "source.organizeImports.ruff": "explicit"
        },
        "editor.defaultFormatter": "charliermarsh.ruff"
    },
    "cSpell.language": "en-AU",
    "cSpell.words": [
        "addopts",
        "aicis",
        "aiic",
        "bitvec",
        "canonicalisation",
        "cascc",
        "casrn",
        "casrns",
        "cheminformatics",
        "chkdig",
        "cids",
        "cscl",
        "csvfile",
        "datastructs",
        "deserialisation",
        "deserialise",
        "deserialised",
        "dotenv",
        "echa",
        "envris",
        "harmonized",
        "hsiun",
        "ichems",
        "iecsc",
        "inchi",
        "inchikey",
        "ipynb",
        "isha",
        "isort",
        "iupac",
        "kecl",
        "openpyxl",
        "outputjson",
        "piccs",
        "plast",
        "plastchem",
        "prtr",
        "pubchem",
        "pycache",
        "pycodestyle",
        "pyflakes",
        "pypdf",
        "pyproject",
        "pytest",
        "pyupgrade",
        "rdkfp",
        "rdkit",
        "reprotoxic",
        "RIDXXXXXXXXXXXXXXXX",
        "sdist",
        "sheetnames",
        "ssic",
        "subdelimiter",
        "svhc",
        "tanimoto",
        "tomllib",
        "tsca",
        "tscainv",
        "unmappable",
        "urllib",
        "vect",
        "venv",
        "vulns",
    ],
    "python.testing.pytestArgs": [
        "tests"
    ],
    "python.testing.unittestEnabled": false,
    "python.testing.pytestEnabled": true,
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
}